# Public
NEXT_PUBLIC_SITE_URL=https://accesslineconsultancy.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=accesslineconsultancy.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CAL_URL=https://cal.com/accessline/discovery

# Database (Neon Postgres)
DATABASE_URL=

# Bot protection
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Accessline Consultancy <hello@accesslineconsultancy.com>"
LEADS_INBOX=info@accesslineconsultancy.com
SLACK_WEBHOOK_URL=

# CV storage (Cloudflare R2, private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=accessline-cvs

# Launch gate: strip all `sample: true` content
HIDE_SAMPLE_CONTENT=false
