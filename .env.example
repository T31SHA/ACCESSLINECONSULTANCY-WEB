# ─────────────────────────────────────────────────────────────────────────────
# Accessline Consultancy Limited — environment variables
# Copy to .env.local for development. On Hostinger: hPanel → your Node.js app → Environment variables.
# Pages work with every variable unset, but the forms need EMAIL (Resend or SMTP) or they return 503.
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin (no trailing slash) for canonicals, sitemap, robots, OG/JSON-LD and email links.
# Defaults to the Hostinger preview domain below; change it once the new domain is live.
NEXT_PUBLIC_SITE_URL=https://slategrey-deer-824136.hostingersite.com
# Public contact email shown site-wide (mailto links, JSON-LD, error messages). Defaults to info@accesslineconsultancy.com.
NEXT_PUBLIC_CONTACT_EMAIL=
# Launch gate: "true" hides every entry marked sample/unverified (MUST be true in production).
HIDE_SAMPLE_CONTENT=false

# ── Content (Sanity) ─────────────────────────────────────────────────────────
# Without a project id the site serves src/content and /studio shows a setup notice.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Optional read token (only needed for a private dataset). Viewer role.
SANITY_API_READ_TOKEN=
# Editor token, only for `npm run sanity:seed` (don't add to the host).
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity GROQ webhook → POST /api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Email (REQUIRED for forms) ───────────────────────────────────────────────
# Contact, quick-enquiry, job-application (with optional CV attachment) and newsletter forms are all
# emailed to LEADS_INBOX with Reply-To set to the person who submitted. No database.
# Transport: Resend if RESEND_API_KEY is set, otherwise SMTP. Without either, forms return 503.
# Inbox that receives every submission. Defaults to the contact email (NEXT_PUBLIC_CONTACT_EMAIL).
LEADS_INBOX=
# Optional From header. Defaults to SMTP_USER (SMTP) or the contact email (Resend).
EMAIL_FROM=

# Option A — Hostinger mailbox over SMTP (no extra account needed):
#   SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465 (SSL) or 587 (STARTTLS)
#   SMTP_USER=the full mailbox address, e.g. forms@yourdomain.com   SMTP_PASS=that mailbox's password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option B — Resend (takes precedence over SMTP when set). Verify the sending domain in Resend first.
RESEND_API_KEY=

# Test/local only: write emails as JSON files to this directory instead of sending. NEVER set in production.
# EMAIL_TEST_OUTBOX=.email-outbox-dev

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# 5 submissions / 10 min per IP on forms.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Booking (Cal.com) ────────────────────────────────────────────────────────
# Public booking link; "Book a call" CTAs only appear when set (can also be set in Studio → Site settings).
NEXT_PUBLIC_CAL_URL=

# ── Analytics (Plausible) ────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Runtime reporting needs only the DSN(s); the SDK isn't loaded without them.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: source-map upload at build time.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
