# ─────────────────────────────────────────────────────────────────────────────
# Accessline Consultancy Limited — environment variables
# Copy to .env.local for development. On Hostinger: hPanel → Websites → (this Node.js app) → Environment variables, then redeploy.
# EVERY variable is optional: features switch off gracefully when unset (see README → "What works without keys").
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin (no trailing slash) for canonicals, sitemap, robots, OG/JSON-LD and email links.
# Defaults to the Hostinger preview domain below; change it once the new domain is live.
NEXT_PUBLIC_SITE_URL=https://slategrey-deer-824136.hostingersite.com
# Public contact email shown site-wide (mailto links, JSON-LD, error messages). Defaults to info@accesslineconsultancy.com.
NEXT_PUBLIC_CONTACT_EMAIL=
# Launch gate: "true" hides every entry marked sample/unverified (MUST be true in production).
HIDE_SAMPLE_CONTENT=false

# ── Content (Sanity) ─────────────────────────────────────────────────────────
# Without a project id the site serves src/content and /studio shows a setup notice.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Optional read token (only needed for a private dataset). Viewer role.
SANITY_API_READ_TOKEN=
# Editor token, only for `npm run sanity:seed` (don't add to hPanel).
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity GROQ webhook → POST /api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Email (REQUIRED for forms) ───────────────────────────────────────────────
# There is no database: every form (contact / "Start a project" / short lead, careers, newsletter)
# is emailed to LEADS_INBOX with Reply-To set to the person who submitted it.
# Without a configured transport the forms return a clear 503 ("please email …").
LEADS_INBOX=
# Sender shown on notifications. With Gmail SMTP use your Gmail address, e.g. "Accessline <you@gmail.com>".
EMAIL_FROM=
# Option 1 — SMTP via nodemailer (e.g. Gmail: enable 2-Step Verification, create an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: force TLS mode ("true" for 465, "false" for STARTTLS on 587). Defaults from the port.
SMTP_SECURE=
# Option 2 — Resend (used instead of SMTP when set; verify your domain in Resend first).
RESEND_API_KEY=
# Local dev / E2E only: log emails instead of sending them.
EMAIL_DRY_RUN=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# 5 submissions / 10 min per IP on forms; login attempts per email.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Booking (Cal.com) ────────────────────────────────────────────────────────
# Public booking link; "Book a call" CTAs only appear when set (can also be set in Studio → Site settings).
NEXT_PUBLIC_CAL_URL=

# ── Analytics (Plausible) ────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Runtime reporting needs only the DSN(s); the SDK isn't loaded without them.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: source-map upload at build time.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
