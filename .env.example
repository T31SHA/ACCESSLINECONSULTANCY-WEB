# ─────────────────────────────────────────────────────────────────────────────
# Accessline Consultancy Limited — environment variables
# Copy to .env.local for development. In Vercel: Project → Settings → Environment Variables.
# EVERY variable is optional: features switch off gracefully when unset (see README → "What works without keys").
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin (no trailing slash) for canonicals, sitemap, robots, OG/JSON-LD and email links.
# Defaults to the Hostinger preview domain below; change it once the new domain is live.
NEXT_PUBLIC_SITE_URL=https://slategrey-deer-824136.hostingersite.com
# Public contact email shown site-wide (mailto links, JSON-LD, error messages). Defaults to info@accesslineconsultancy.com.
NEXT_PUBLIC_CONTACT_EMAIL=
# Launch gate: "true" hides every entry marked sample/unverified (MUST be true in production).
HIDE_SAMPLE_CONTENT=false

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Production: Neon pooled connection string (postgres://…). Run `npm run db:migrate` once.
# Local/dev alternative: pglite://.pglite-dev  (in-process Postgres, auto-migrates, no install)
DATABASE_URL=

# ── Content (Sanity) ─────────────────────────────────────────────────────────
# Without a project id the site serves src/content and /studio shows a setup notice.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Optional read token (only needed for a private dataset). Viewer role.
SANITY_API_READ_TOKEN=
# Editor token, only for `npm run sanity:seed` (don't add to Vercel).
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity GROQ webhook → POST /api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Admin (/admin lead dashboard, Auth.js) ───────────────────────────────────
# Generate: `openssl rand -base64 32`
AUTH_SECRET=
# Comma-separated allowlist of people who may sign in (required for /admin).
ADMIN_EMAILS=
# scrypt hash from `npm run admin:hash -- 'a-long-passphrase'` (preferred).
ADMIN_PASSWORD_HASH=
# Plain password: dev/test fallback only, ignored when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=

# ── Email (Resend) + Slack ───────────────────────────────────────────────────
# Lead notifications, auto-replies and newsletter confirmations. Verify the domain in Resend first.
RESEND_API_KEY=
# Both default to the contact email (NEXT_PUBLIC_CONTACT_EMAIL) when left empty.
EMAIL_FROM=
LEADS_INBOX=
# Optional Slack incoming-webhook URL for new-lead pings.
SLACK_WEBHOOK_URL=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# 5 submissions / 10 min per IP on forms; login attempts per email.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CV storage (Cloudflare R2, PRIVATE bucket) ───────────────────────────────
# Needs a CORS rule allowing PUT from the site origin (see README).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=accessline-cvs

# ── Booking (Cal.com) ────────────────────────────────────────────────────────
# Public booking link; "Book a call" CTAs only appear when set (can also be set in Studio → Site settings).
NEXT_PUBLIC_CAL_URL=
# Secret configured on the Cal.com webhook → POST /api/webhooks/cal
CAL_WEBHOOK_SECRET=

# ── Retention cron (Vercel Cron → /api/cron/retention, daily) ────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically when this is set.
CRON_SECRET=

# ── Analytics (Plausible) ────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Runtime reporting needs only the DSN(s); the SDK isn't loaded without them.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: source-map upload at build time.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
